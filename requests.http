
### List all students
GET http://localhost:8080/students

###

### Create a student
POST http://localhost:8080/students
Content-Type: application/json

{
    "name": "Ana",
    "studyHours": 5
}

###

### Get a student
GET http://localhost:8080/students/1

###

### Update a student
PUT http://localhost:8080/students/1
Content-Type: application/json

{
    "name": "Ana",
    "studyHours": 8
}

###

### Delete a student
DELETE http://localhost:8080/students/1

###

### Predict grade directly from the Python service
POST http://localhost:8000/predict
Content-Type: application/json

{
    "study_hours": 12,
    "difficulty": "MEDIUM"
}

###

### List subjects
GET http://localhost:8080/api/subjects

###

### Create a subject
POST http://localhost:80£80/api/subjects
Content-Type: application/json

{
    "name": "Algoritmos",
    "difficulty": "MEDIUM"
}

###

### Create a student enrolled in subject 1
POST http://localhost:8080/students
Content-Type: application/json

{
    "name": "Ana",
    "studyHours": 5,
    "enrollments": [
        {
            "subjectId": 1,
            "studyHours": 12,
            "course": "1º",
            "academicYear": "2025-2026",
            "grade": 8.5
        }
    ]
}

###

### Download student report as CSV
GET http://localhost:8080/students/1/report?format=csv

###

### Download student report as JSON
GET http://localhost:8080/students/1/report?format=json

###

### Call the report service directly
POST http://localhost:8001/reports/csv
Content-Type: application/json

{
    "student": 1,
    "name": "Ana",
    "academic_year": "2025-2026",
    "records": [
        {
            "subject": "Algoritmos",
            "course": "1º",
            "academic_year": "2025-2026",
            "score": 8.5
        }
    ]
}